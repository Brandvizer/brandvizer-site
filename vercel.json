{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/beheer",
      "destination": "https://brandvizer-voorstel.rudolf-23d.workers.dev/beheer",
      "permanent": false
    },
    {
      "source": "/beheer/:pad*",
      "destination": "https://brandvizer-voorstel.rudolf-23d.workers.dev/beheer/:pad*",
      "permanent": false
    }
  ]
}
